# Copy to .env and fill in. Never commit .env.
# All variables are read by src/va_project/config.py (names are case-insensitive).

# --- App ---------------------------------------------------------------
APP_HOST=127.0.0.1            # keep 127.0.0.1 locally; 0.0.0.0 only inside Docker (Caddy in front)
APP_PORT=8050
DEBUG=false
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR

# --- Storage -----------------------------------------------------------
DATA_DIR=./data

# --- Source A: GTFS-RT (opentransportdata.swiss) ------------------------
# Free key: https://api-manager.opentransportdata.swiss/
GTFS_RT_API_KEY=
GTFS_RT_URL=https://api.opentransportdata.swiss/la/gtfs-rt   # trip updates
GTFS_SA_URL=https://api.opentransportdata.swiss/la/gtfs-sa   # service alerts (subscribe separately in the API manager)
GTFS_RT_POLL_SECONDS=60       # >= 60: at most 1 request/minute per feed

# --- Source B: BFS HESTA (PxWeb, no key) --------------------------------
BFS_PXWEB_URL=https://www.pxweb.bfs.admin.ch/api/v1/de

# --- Source C: MeteoSwiss SwissMetNet (STAC, no key) --------------------
METEO_STAC_URL=https://data.geo.admin.ch/api/stac/v1/collections/ch.meteoschweiz.ogd-smn
METEO_STATION=CHU             # SwissMetNet station abbreviation used by the feasibility check

# --- Link source: service points (stop → BFS municipality), no key -----
SERVICE_POINTS_URL=https://data.opentransportdata.swiss/en/dataset/service-points-actual-date/permalink

# --- Live collector (US-02b) --------------------------------------------
LIVE_RAW_KEEP_DAYS=3          # raw GTFS-RT/weather snapshots are deleted after this (once compacted)
LIVE_COMPACT_MINUTES=60       # compaction interval while the collector runs
METEO_POLL_MINUTES=10         # SwissMetNet publishes every 10 minutes

# --- Monitoring --------------------------------------------------------
STALE_AFTER_MINUTES=10        # /api/v1/health marks real-time feeds stale after this

# --- Deployment (VM only, used by deploy/Caddyfile) ---------------------
DOMAIN=swissflow.example.ch
# Create hash with:  docker run --rm caddy:2 caddy hash-password --plaintext 'your-password'
BASIC_AUTH_USER=team
BASIC_AUTH_HASH=
